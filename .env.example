# ==========================================
# Telegram Bot Configuration
# ==========================================
# Create your bot with @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The public HTTPS URL where Render hosts your app (required for Webhook)
# Leave blank to use Long Polling for local development!
TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com/telegram/webhook
TELEGRAM_SECRET_TOKEN=generate_random_secret_string

# ==========================================
# Multi-Tenant Database (Neon PostgreSQL)
# ==========================================
# Sign up at neon.tech (Free Tier) and paste your connection string here.
# If left blank or "sqlite", the app will safely fall back to local SQLite (for local dev).
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Security & Credential Encryption
# ==========================================
# Master Fernet key used to encrypt user Odoo API keys at rest.
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# ==========================================
# Multi-Provider LLM Configuration
# ==========================================
# Choose active provider: 'auto', 'openrouter', 'gemini', 'groq', 'nvidia', 'ollama', 'openai', or 'custom'
# If set to 'auto', it uses whichever key you supply, with automatic fallback across providers!
LLM_PROVIDER=auto

# 1. OpenRouter (Access to free and paid models: Claude, Gemini, DeepSeek, Llama)
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat,google/gemini-2.0-flash-001,qwen/qwen-2.5-72b-instruct

# 2. Google Gemini (Generous free tier with fast tool-calling)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash

# 3. Groq (Ultra-fast inference)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# 4. NVIDIA NIM (Developer catalog)
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=meta/llama-3.3-70b-instruct,meta/llama-3.1-70b-instruct

# 5. Local Ollama (Zero cost, local execution)
# Run `ollama run qwen2.5:7b` or `ollama run llama3.1`
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# 6. OpenAI Direct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Server Settings
# ==========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
